{
  "name": "longjump",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && tsc --project worker/tsconfig.json && vite build",
    "accounts:setup": "bun scripts/setup-account-dev.ts && bunx wrangler d1 migrations apply longjump-accounts --local --config worker/wrangler.jsonc",
    "accounts:dev": "bunx wrangler dev --config worker/wrangler.jsonc --port 8787",
    "test": "bun test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "lucide": "^1.53.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/three": "^0.180.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.149.0"
  },
  "packageManager": "bun@1.4.2"
}
