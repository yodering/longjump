{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "longjump",
  "main": "index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "longjump-accounts", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "AUTH_ORIGIN": "https://longjump.ing" }
}
